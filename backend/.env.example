PORT=3000

# where task state lives: firestore, or memory (lost on restart)
STORE=firestore

# valyu = real research (Valyu + Gemini), fake = offline pipeline with canned events
PIPELINE=valyu

# GCP project for Firestore and Vertex AI (uses your gcloud login locally)
GOOGLE_CLOUD_PROJECT="valyu-research"

# secrets: copied into Secret Manager by deploy/secrets.sh, never sent to the browser
VALYU_API_KEY=
ACCESS_CODE=

# optional: model per stage (plan + reflect, write)
# MODEL_PLAN=gemini-3.8-flash
# MODEL_WRITE=gemini-3.8-flash

# deployment only (set by deploy/deploy.sh); leave unset locally to run tasks in-process
# QUEUE=cloudtasks
# TASKS_LOCATION= TASKS_QUEUE= TASKS_SA= WORKER_URL=
